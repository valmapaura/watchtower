# Local credentials - never commit this file
config.json

# Local secrets (RTSP URLs, API tokens) - never commit
secrets.local.json
*.local.json

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/

# Snapshots from the viewer
snapshots/

# Video recordings (large binaries)
recordings/
*.mp4
*.mkv
*.avi
*.mov
*.ts

# Local logs
logs/

# Vendor client installer (large binary)
client/CAM720_1.0.0.6.exe

# Next.js build output (client/web holds the web UI)
client/web/.next/
client/web/node_modules/
client/web/out/

# Electron desktop app (client/desktop)
client/desktop/node_modules/
client/desktop/dist/
client/desktop/release/
client/desktop/build/
client/desktop/*.txt

# Session store (local auth state)
.wt_sessions.json

# YOLO model weights (downloaded on demand)
*.pt

# Editor
.vscode/
.idea/

# Binary SDK and tools (camera SDK, FFmpeg, Qt plugins, etc.)
installation/CAM720VmsTools/**

# Log files generated by the SDK
installation/CAM720VmsTools/log/

# Common OS/IDE generated files
.DS_Store
Thumbs.db
